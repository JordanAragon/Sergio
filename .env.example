# Copia este archivo como .env para probar con la hoja real. Nada de esto es secreto:
# todo termina en el navegador del cliente. Sin estas variables se usan los datos de ejemplo de datos/.

# Dominio de la tienda, sin barra final (Open Graph, sitemap y QR).
SITIO_URL=https://tumarca.com

# Pestañas de la hoja publicadas como CSV (Archivo › Compartir › Publicar en la web › pestaña › CSV).
PUBLIC_CSV_PRODUCTOS=
PUBLIC_CSV_COLABORACIONES=
PUBLIC_CSV_TIENDA=

# URL de la aplicación web del Apps Script (hoja/Codigo.gs) que registra los pedidos.
PUBLIC_REGISTRO_PEDIDOS_URL=

# Token de Cloudflare Web Analytics (opcional; en Cloudflare Pages también se activa con un clic).
PUBLIC_CF_ANALYTICS_TOKEN=
