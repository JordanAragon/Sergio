---
import Base from "../../layouts/Base.astro";
import TarjetaProducto from "../../components/TarjetaProducto.astro";
import Filtros from "../../components/Filtros.astro";
import Sello from "../../components/Sello.astro";
import Foto from "../../components/Foto.astro";
import { catalogo, ordenVitrina, productosDe } from "../../datos/fuente";

export async function getStaticPaths() {
  const cat = await catalogo();
  return cat.colecciones.filter((c) => c.estado === "visible").map((c) => ({ params: { handle: c.handle } }));
}

const cat = await catalogo();
const c = cat.colecciones.find((x) => x.handle === Astro.params.handle)!;
const productos = ordenVitrina(productosDe(cat, c.handle));
const descripcion = c.descripcion && !c.descripcion.startsWith("[") ? c.descripcion : `${c.nombre} de ${cat.tienda.nombre} en colaboración con ${c.marca}. Pide por WhatsApp.`;
---

<Base titulo={`${c.nombre} × ${c.marca}`} descripcion={descripcion} imagen={`/og/coleccion/${c.handle}.png`} acento={c.color} actual={c.handle}>
  <section class="portada" style={`--color: ${c.color}`}>
    <div class="contenedor rejilla">
      <div class="texto">
        <Sello tienda={cat.tienda.nombre} marca={c.marca} logo={c.logo} />
        <h1>{c.nombre}</h1>
        {c.descripcion && <p>{c.descripcion}</p>}
      </div>
      <div class="foto">
        {c.foto ? <Foto src={c.foto} alt={`Campaña de ${c.marca}`} ancho={1200} sizes="(min-width: 900px) 50vw, 100vw" prioridad /> : <span class="rayas">Foto de campaña de la marca</span>}
      </div>
    </div>
  </section>

  <section class="contenedor">
    <Filtros productos={productos} etiquetaTipos={`Tipos de ${c.nombre.toLowerCase()}`} />
    <div class="grilla" data-grilla>
      {productos.map((p, i) => <TarjetaProducto producto={p} prioridad={i < 2} />)}
    </div>
    {productos.length === 0 && <p class="suave">Pronto habrá productos en esta sección.</p>}
  </section>

  {
    c.guiaTallas.length > 0 && (
      <section class="contenedor guia" id="guia" aria-labelledby="titulo-guia">
        <h2 id="titulo-guia">Guía de tallas</h2>
        <table>
          <tbody>
            <tr>
              <th scope="row">Talla</th>
              {c.guiaTallas.map((g) => (
                <td>{g.talla}</td>
              ))}
            </tr>
            <tr>
              <th scope="row">Medida</th>
              {c.guiaTallas.map((g) => (
                <td>{g.medida}</td>
              ))}
            </tr>
          </tbody>
        </table>
      </section>
    )
  }
</Base>

<style>
  .portada {
    background: var(--color);
    color: var(--papel);
  }

  .rejilla {
    display: grid;
    gap: 20px;
    padding-top: 22px;
    padding-bottom: 26px;
  }

  @media (min-width: 900px) {
    .rejilla {
      grid-template-columns: 1fr 1fr;
      align-items: end;
      gap: 48px;
      padding-top: 48px;
      padding-bottom: 48px;
    }
  }

  .texto {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h1 {
    font-size: clamp(38px, 6vw, 72px);
    line-height: 0.98;
  }

  .texto p {
    margin: 0;
    font-size: 15px;
    color: rgb(243 242 239 / 0.85);
    max-width: 48ch;
  }

  .foto {
    position: relative;
    height: 200px;
    overflow: hidden;
    border-radius: 2px;
  }

  @media (min-width: 900px) {
    .foto {
      height: 360px;
    }
  }

  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rayas {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.07) 0 14px, transparent 14px 28px);
    font-size: 13px;
    color: rgb(243 242 239 / 0.75);
  }

  .guia {
    padding-top: 48px;
  }

  .guia h2 {
    font-size: 24px;
    margin-bottom: 14px;
  }

  table {
    border-collapse: collapse;
    background: var(--superficie);
    border-radius: 4px;
    font-size: 14px;
    display: block;
    overflow-x: auto;
    width: max-content;
    max-width: 100%;
  }

  th,
  td {
    padding: 10px 14px;
    text-align: center;
    border-bottom: 1px solid var(--linea);
    white-space: nowrap;
  }

  th {
    text-align: left;
    font-weight: 700;
  }
</style>
