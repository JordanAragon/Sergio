---
import Base from "../layouts/Base.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import Foto from "../components/Foto.astro";
import { catalogo, ordenVitrina, productosDe } from "../datos/fuente";

const cat = await catalogo();
const { tienda, colecciones } = cat;
const nuevos = ordenVitrina(cat.productos.filter((p) => p.nuevo && !p.agotado)).slice(0, 8);
const vitrina = nuevos.length ? nuevos : ordenVitrina(cat.productos).slice(0, 8);
const resumenTipos = (handle: string) => [...new Set(productosDe(cat, handle).map((p) => p.tipo).filter(Boolean))].slice(0, 3);
---

<Base>
  <section class="contenedor intro">
    <p class="sobretitulo suave">Colaboraciones</p>
    <h1>{tienda.lema || tienda.nombre}</h1>
  </section>

  <nav class="contenedor" aria-label="Categorías">
    <div class="fila-chips">
      {
        colecciones
          .filter((c) => c.estado === "visible")
          .map((c) => (
            <a class="chip" href={`/coleccion/${c.handle}`}>
              {c.nombre}
            </a>
          ))
      }
      <a class="chip" href="/nuevo">Lo nuevo</a>
    </div>
  </nav>

  <section class="contenedor portadas" aria-label="Colaboraciones">
    {
      colecciones.map((c, i) => {
        const tipos = resumenTipos(c.handle);
        const subt = c.subtitulo || tipos.join(", ");
        return c.estado === "pronto" ? (
          <div class="portada pronto">
            <div class="portada-texto">
              <div class="sobretitulo">
                {tienda.nombre} × {c.marca}
              </div>
              <div class="portada-nombre">{c.nombre} · próximamente</div>
            </div>
          </div>
        ) : (
          <a class:list={["portada", { grande: i === 0 }]} href={`/coleccion/${c.handle}`} style={`--color: ${c.color}`}>
            <div class="portada-foto">
              {c.foto ? <Foto src={c.foto} alt="" ancho={1200} sizes="(min-width: 768px) 50vw, 100vw" prioridad={i === 0} /> : <span class="rayas">Foto de campaña · {c.nombre.toLowerCase()}</span>}
            </div>
            <div class="portada-texto">
              <div class="sobretitulo">
                {tienda.nombre} × {c.marca}
              </div>
              <div class="portada-nombre">{c.nombre}</div>
              {subt && <div class="portada-sub">{subt}</div>}
            </div>
          </a>
        );
      })
    }
  </section>

  {
    vitrina.length > 0 && (
      <section class="contenedor bloque" aria-labelledby="titulo-nuevo">
        <div class="bloque-cabeza">
          <h2 id="titulo-nuevo">{nuevos.length ? "Lo nuevo" : "Productos"}</h2>
          <a href="/nuevo">Ver todo</a>
        </div>
        <div class="grilla">
          {vitrina.map((p, i) => (
            <TarjetaProducto producto={p} prioridad={i < 2} />
          ))}
        </div>
      </section>
    )
  }

  <section class="contenedor bloque">
    <div class="como">
      <h2>Cómo pedir</h2>
      <ol>
        <li><span>1</span>Elige el producto, la talla y el color.</li>
        <li><span>2</span>Revisa tu pedido y escribe a dónde lo enviamos.</li>
        <li><span>3</span>Envíalo por WhatsApp y te confirmamos pago y entrega.</li>
      </ol>
      {
        (tienda.envioTiempo || tienda.pago) && (
          <p class="suave como-pie">
            {[tienda.envioTiempo && `Entrega: ${tienda.envioTiempo}.`, tienda.pago && `Pago: ${tienda.pago}.`].filter(Boolean).join(" ")}
          </p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-top: 28px;
    padding-bottom: 20px;
  }

  .intro .sobretitulo {
    margin-bottom: 10px;
    letter-spacing: 0.14em;
    font-weight: 400;
  }

  h1 {
    font-size: clamp(40px, 7vw, 84px);
    line-height: 0.98;
    max-width: 16ch;
  }

  nav.contenedor {
    padding-bottom: 24px;
  }

  .portadas {
    display: grid;
    gap: 14px;
  }

  @media (min-width: 768px) {
    .portadas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .portada.grande {
      grid-column: 1 / -1;
    }

    .portada.grande .portada-foto {
      height: 460px;
    }
  }

  .portada {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--papel);
    border-radius: 4px;
    overflow: hidden;
    background: var(--color, var(--tinta));
  }

  .portada:hover {
    color: var(--papel);
  }

  .portada-foto {
    position: relative;
    height: 240px;
    overflow: hidden;
  }

  .grande .portada-foto {
    height: 300px;
  }

  .portada-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .portada:hover .portada-foto :global(img) {
    transform: scale(1.03);
  }

  .rayas {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.07) 0 14px, transparent 14px 28px);
    font-size: 13px;
    color: rgb(243 242 239 / 0.75);
  }

  .portada-texto {
    padding: 18px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .portada-nombre {
    font-weight: 800;
    font-stretch: 112%;
    font-size: 28px;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .grande .portada-nombre {
    font-size: clamp(28px, 4vw, 44px);
  }

  .portada-sub {
    font-size: 14px;
    opacity: 0.85;
  }

  .pronto {
    background: var(--foto);
    color: var(--tinta);
    align-self: start;
  }

  .pronto .portada-nombre {
    font-size: 24px;
  }

  .bloque {
    padding-top: 44px;
  }

  .bloque-cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .bloque-cabeza h2 {
    font-size: 26px;
  }

  .bloque-cabeza a {
    font-size: 14px;
    font-weight: 600;
  }

  .como {
    padding: 24px 20px;
    background: var(--superficie);
    border-radius: 4px;
  }

  .como h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }

  .como ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
    font-size: 15px;
    line-height: 1.35;
  }

  @media (min-width: 768px) {
    .como {
      padding: 32px;
    }

    .como ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }
  }

  .como li {
    display: flex;
    gap: 12px;
  }

  .como li span {
    font-weight: 800;
    color: var(--acento);
  }

  .como-pie {
    margin: 18px 0 0;
    font-size: 14px;
  }
</style>
