---
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import Icono from "../../components/Icono.astro";
import TarjetaProducto from "../../components/TarjetaProducto.astro";
import Compra from "../../islas/Compra";
import { catalogo, ordenVitrina } from "../../datos/fuente";
import { pesos } from "../../lib/pedido";

export async function getStaticPaths() {
  const cat = await catalogo();
  return cat.productos.map((p) => ({ params: { handle: p.handle } }));
}

const cat = await catalogo();
const { tienda } = cat;
const p = cat.productos.find((x) => x.handle === Astro.params.handle)!;
const c = cat.colecciones.find((x) => x.handle === p.coleccion);
const sello = c ? `${tienda.nombre} × ${c.marca}` : p.marca;
const volver = c ? { href: `/coleccion/${c.handle}`, texto: `Volver a ${c.nombre.toLowerCase()}` } : { href: "/", texto: "Volver al inicio" };
const fotoColor = new Map(p.variantes.filter((v) => v.imagen).map((v) => [v.imagen!, v.color]));
const fotos = p.imagenes.length ? p.imagenes : [null];
const relacionados = ordenVitrina(cat.productos.filter((x) => x.coleccion === p.coleccion && x.handle !== p.handle && !x.agotado)).slice(0, 4);
const descripcion = p.descripcion && !p.descripcion.startsWith("[") ? p.descripcion : `${p.titulo}${c ? ` · ${c.nombre}` : ""}. ${pesos(p.precio)}. Pide por WhatsApp en ${tienda.nombre}.`;
const site = Astro.site ?? new URL("http://localhost:4321");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.titulo,
  description: descripcion,
  brand: p.marca ? { "@type": "Brand", name: p.marca } : undefined,
  image: p.imagenes.length ? p.imagenes.map((i) => new URL(i, site).href) : undefined,
  sku: p.variantes[0]?.sku || undefined,
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "COP",
    lowPrice: Math.min(...p.variantes.map((v) => v.precio)),
    highPrice: Math.max(...p.variantes.map((v) => v.precio)),
    offerCount: p.variantes.length,
    availability: p.agotado ? "https://schema.org/OutOfStock" : "https://schema.org/InStock",
  },
};
---

<Base titulo={p.titulo} descripcion={descripcion} imagen={`/og/producto/${p.handle}.png`} imagenAlt={`${p.titulo} en ${tienda.nombre}`} tipo="product" acento={c?.color} actual={c?.handle}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <div class="contenedor migas">
    <a href={volver.href} class="volver"><Icono nombre="volver" tam={18} /> {volver.texto}</a>
  </div>

  <div class="contenedor ficha">
    <div class="galeria-columna">
      <div class="galeria" data-galeria tabindex="0" aria-label={`Fotos de ${p.titulo}`}>
        {
          fotos.map((src, i) => (
            <figure class="galeria-foto" data-color={src ? (fotoColor.get(src) ?? "") : ""}>
              <Foto src={src} alt={src ? `${p.titulo}, foto ${i + 1} de ${fotos.length}` : `Foto de ${p.titulo}`} marcador={`Foto · ${p.titulo.toLowerCase()}`} ancho={1200} sizes="(min-width: 900px) 55vw, 100vw" prioridad={i === 0} />
            </figure>
          ))
        }
      </div>
      {
        fotos.length > 1 && (
          <div class="puntos" aria-hidden="true">
            {fotos.map((_, i) => (
              <span class:list={{ activo: i === 0 }} />
            ))}
          </div>
        )
      }
    </div>

    <div class="info">
      <div class="cabeza">
        <p class="sobretitulo suave">{sello}</p>
        <h1>{p.titulo}</h1>
        {p.descripcion && <p class="descripcion">{p.descripcion}</p>}
      </div>

      <Compra
        client:load
        handle={p.handle}
        titulo={p.titulo}
        marca={p.marca}
        sello={sello}
        imagen={p.imagenes[0] ?? null}
        variantes={p.variantes}
        colores={p.colores}
        tallas={p.tallas}
        conGuia={!!c && c.guiaTallas.length > 0}
      />

      {
        c && c.guiaTallas.length > 0 && (
          <section class="guia" id="guia" aria-labelledby="titulo-guia">
            <h2 id="titulo-guia">Guía de tallas</h2>
            <dl>
              {c.guiaTallas.map((g) => (
                <div>
                  <dt>{g.talla}</dt>
                  <dd>{g.medida}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <div class="acordeones">
        <details>
          <summary>Envíos y tiempos</summary>
          <p>
            {tienda.envioCiudades ? `Enviamos a ${tienda.envioCiudades}.` : "Te confirmamos el envío por WhatsApp."}
            {tienda.envioTiempo && ` Tiempo de entrega: ${tienda.envioTiempo}.`}
            {tienda.envioCosto !== null ? ` Costo: ${pesos(tienda.envioCosto)}.` : " El costo se confirma por WhatsApp."}
            {tienda.envioGratisDesde !== null && ` Gratis en compras desde ${pesos(tienda.envioGratisDesde)}.`}
            {tienda.recogidaLugar && ` También puedes recoger en ${tienda.recogidaLugar}.`}
          </p>
        </details>
        <details>
          <summary>Cambios y retracto</summary>
          <p>
            Puedes retractarte de la compra dentro de los 5 días hábiles siguientes a la entrega, con el producto sin uso y en su empaque. <a href="/envios-y-cambios">Condiciones de cambio y retracto</a>.
          </p>
        </details>
      </div>
    </div>
  </div>

  {
    relacionados.length > 0 && (
      <section class="contenedor relacionados" aria-labelledby="titulo-relacionados">
        <h2 id="titulo-relacionados">También en {c?.nombre.toLowerCase()}</h2>
        <div class="grilla">
          {relacionados.map((r) => (
            <TarjetaProducto producto={r} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<script>
  const galeria = document.querySelector<HTMLElement>("[data-galeria]");
  const puntos = [...document.querySelectorAll<HTMLElement>(".puntos span")];
  if (galeria) {
    const fotos = [...galeria.querySelectorAll<HTMLElement>(".galeria-foto")];
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            const i = fotos.indexOf(e.target as HTMLElement);
            puntos.forEach((p, j) => p.classList.toggle("activo", j === i));
          }
        }
      },
      { root: galeria, threshold: 0.6 },
    );
    fotos.forEach((f) => io.observe(f));
    document.addEventListener("galeria:color", (e) => {
      const color = (e as CustomEvent<string>).detail;
      const destino = fotos.find((f) => f.dataset.color === color);
      if (!destino) return;
      const vertical = getComputedStyle(galeria).flexDirection === "column";
      if (vertical) destino.scrollIntoView({ behavior: "smooth", block: "nearest" });
      else galeria.scrollTo({ left: destino.offsetLeft - galeria.offsetLeft, behavior: "smooth" });
    });
  }
</script>

<style>
  .migas {
    padding-top: 12px;
    padding-bottom: 8px;
  }

  .volver {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .ficha {
    display: grid;
    gap: 18px;
  }

  @media (min-width: 900px) {
    .ficha {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }

    .info {
      position: sticky;
      top: 96px;
    }
  }

  .galeria-columna {
    margin-inline: calc(var(--margen) * -1);
  }

  @media (min-width: 900px) {
    .galeria-columna {
      margin-inline: 0;
    }
  }

  .galeria {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    gap: 6px;
    padding-inline: var(--margen);
    scroll-padding-inline: var(--margen);
  }

  .galeria::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 900px) {
    .galeria {
      flex-direction: column;
      overflow: visible;
      padding: 0;
      gap: 12px;
    }
  }

  .galeria-foto {
    margin: 0;
    flex: 0 0 100%;
    aspect-ratio: 4 / 5;
    scroll-snap-align: start;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--foto);
  }

  .galeria-foto :global(img),
  .galeria-foto :global(.sin-foto) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .puntos {
    display: flex;
    gap: 6px;
    justify-content: center;
    padding: 12px 0 4px;
  }

  .puntos span {
    width: 6px;
    height: 4px;
    border-radius: 2px;
    background: var(--gris-claro);
    transition: width 0.2s ease;
  }

  .puntos span.activo {
    width: 18px;
    background: var(--tinta);
  }

  @media (min-width: 900px) {
    .puntos {
      display: none;
    }
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .cabeza {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  h1 {
    font-size: clamp(30px, 4vw, 44px);
  }

  .descripcion {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--tinta-2);
  }

  .guia {
    padding: 16px;
    background: var(--superficie);
    border-radius: 4px;
  }

  .guia h2 {
    font-size: 14px;
    font-weight: 700;
    font-stretch: 100%;
    letter-spacing: 0;
    margin-bottom: 10px;
  }

  .guia dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
    gap: 8px 4px;
    font-size: 13px;
    text-align: center;
  }

  .guia dt {
    font-weight: 700;
  }

  .guia dd {
    margin: 0;
    color: var(--tinta-2);
  }

  .acordeones {
    font-size: 14px;
    line-height: 1.5;
  }

  details {
    border-top: 1px solid var(--linea);
    padding: 4px 0;
  }

  details:last-child {
    border-bottom: 1px solid var(--linea);
  }

  summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    font-weight: 700;
    cursor: pointer;
  }

  details p {
    margin: 0 0 12px;
    color: var(--tinta-2);
  }

  .relacionados {
    padding-top: 56px;
  }

  .relacionados h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }
</style>
